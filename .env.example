# Скопируй в .env.local и заполни. .env.local в git не попадает.
# Токен бота НИКОМУ не показывай и не кидай в чат.

# --- сервер (Vercel Function api/bot.ts) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WEBAPP_URL=

# Telegram ID админов через запятую (узнать: команда /id в боте)
ADMIN_IDS=
# BLOB_READ_WRITE_TOKEN Vercel добавляет сам, когда хранилище подключено к проекту

# Статистика: бесплатная база Upstash Redis (console.upstash.com → Create Database → план Free, карта не нужна).
# Значения — на странице базы, блок REST API. Без них игра работает, просто статистика не считается.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Секрет для ежедневной сводки (Vercel Cron присылает его сам); любое длинное случайное значение
CRON_SECRET=
# Часовой пояс отчётов относительно UTC (по умолчанию 3 — Москва; Казахстан — 5)
STATS_TZ=3

# --- клиент (попадает в сборку, тут только публичное) ---
# Ник бота без @ и короткое имя мини-аппа из /newapp в @BotFather.
# Без них «Вызов другу» копирует ссылку на сайт (удобно для тестов в браузере).
VITE_BOT_USERNAME=
VITE_APP_SHORTNAME=
